<html dir='ltr' lang='en'>
  <head>
    <link
      rel='preload'
      as='image'
      href='https://storage.googleapis.com/intervuvave-uploads/intervuave-logo-final.svg'
    />
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <meta name='x-apple-disable-message-reformatting' />
    <!--$-->
  </head>
  <body
    style='background-color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Oxygen-Sans,Ubuntu,Cantarell,"Helvetica Neue",sans-serif'
  >
    <table
      align='center'
      width='100%'
      border='0'
      cellpadding='0'
      cellspacing='0'
      role='presentation'
      style='max-width:37.5em;margin:0 auto;padding:20px 0 48px'
    >
      <tbody>
        <tr style='width:100%'>
          <td>

            <img
              height='100'
              src='https://i.ibb.co/whYQgC38/logo-color-removebg-preview.png'
              style='display:block;outline:none;border:none;text-decoration:none;margin:0 auto'
              width='100'
            />
            <p
              style='font-size:16px;line-height:26px;margin-bottom:16px;margin-top:16px'
            >
              Hi there,
            </p>
            <div style="background-color:#E8F5E8; border-left:4px solid #4CAF50; padding:12px 20px; margin:24px 0; border-radius:4px;">
              <p style="font-size:18px; font-weight:bold; color:#4CAF50; margin:0 0 8px 0;">🎉 You're Invited!</p>
              <p style="font-size:16px; margin:0;">You've been invited to join {{organizationName}} on our platform.</p>
            </div>
            <p
              style='font-size:16px;line-height:26px;margin-bottom:16px;margin-top:16px'
            >
              {{inviterName}} from {{organizationName}} has invited you to join their workspace. 
              You'll be able to collaborate on projects, manage test cases, and work with your team members.
            </p>
            <p
              style='font-size:16px;line-height:26px;margin-bottom:16px;margin-top:16px; font-weight:bold; color:#1976D2;'
            >
              Your invitation will expire in 7 days. Please accept the invitation to get started.
            </p>
            <table
              align='center'
              width='100%'
              border='0'
              cellpadding='0'
              cellspacing='0'
              role='presentation'
              style='text-align:center'
            >
              <tbody>
                <tr>
                  <td>
                    <a
                      href='{{invitationLink}}'
                      style='line-height:100%;text-decoration:none;display:block;max-width:100%;mso-padding-alt:0px;background-color:#5F51E8;border-radius:8px;color:#fff;font-size:16px;text-align:center;padding:12px 12px 12px 12px'
                      target='_blank'
                    ><span
                      ><!--[if mso]><i style="mso-font-width:300%;mso-text-raise:18" hidden>&#8202;&#8202;</i><![endif]--></span><span
                        style='max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px'
                      >Accept Invitation</span><span
                      ><!--[if mso]><i style="mso-font-width:300%" hidden>&#8202;&#8202;&#8203;</i><![endif]--></span></a>
                  </td>
                </tr>
              </tbody>
            </table>
            <p
              style='font-size:16px;line-height:26px;margin-bottom:16px;margin-top:24px'
            >
              If you have any questions about this invitation, please contact {{adminName}} or reply to this email.
            </p>
            <p
              style='font-size:16px;line-height:26px;margin-bottom:16px;margin-top:16px'
            >
              Best regards,<br />
              The {{organizationName}} Team
              <br />
              (invitation sent by {{adminName}})
            </p>
          </td>
        </tr>
      </tbody>
    </table>
    <!--/$-->
  </body>
</html>